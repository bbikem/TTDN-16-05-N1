<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_chung_chi_tree" model="ir.ui.view">
      <field name="name">chung_chi.tree</field>
      <field name="model">chung_chi</field>
      <field name="arch" type="xml">
        <tree>
          <field name="nhan_vien_id" string="Nhân viên"/>
          <field name="ten_chung_chi" string="Tên chứng chỉ"/>
          <field name="so_hieu" string="Số hiệu"/>
          <field name="don_vi_cap" string="Đơn vị cấp"/>
          <field name="ngay_cap" string="Ngày cấp"/>
          <field name="ngay_het_han" string="Ngày hết hạn"/>
        </tree>
      </field>
    </record>

    <record id="view_chung_chi_search" model="ir.ui.view">
      <field name="name">chung_chi.search</field>
      <field name="model">chung_chi</field>
      <field name="arch" type="xml">
        <search>
          <field name="nhan_vien_id"/>
          <field name="ten_chung_chi"/>
          <field name="don_vi_cap"/>
          <filter string="Sắp hết hạn" name="exp_soon"
                  domain="[('ngay_het_han','!=',False),('ngay_het_han','&lt;=', (context_today() + relativedelta(months=1)))]"/>
        </search>
      </field>
    </record>

    <record id="view_chung_chi_form" model="ir.ui.view">
      <field name="name">chung_chi.form</field>
      <field name="model">chung_chi</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="ten_chung_chi" placeholder="Tên chứng chỉ" required="1"/>
              </h1>
              <div class="text-muted">
                <span>Nhân viên:</span>
                <field name="nhan_vien_id" class="oe_inline" required="1"/>
              </div>
            </div>

            <group col="4">
              <field name="so_hieu"/>
              <field name="don_vi_cap"/>
              <field name="ngay_cap"/>
              <field name="ngay_het_han"/>
            </group>

            <notebook>
              <page string="Ghi chú">
                <field name="ghi_chu" placeholder="Ghi chú..."/>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="action_chung_chi" model="ir.actions.act_window">
      <field name="name">Chứng chỉ</field>
      <field name="res_model">chung_chi</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="view_chung_chi_search"/>
    </record>

  </data>
</odoo>
