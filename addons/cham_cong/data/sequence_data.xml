<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence cho Tính công -->
        <record id="seq_tinh_cong" model="ir.sequence">
            <field name="name">Tính công</field>
            <field name="code">tinh_cong.sequence</field>
            <field name="prefix">TC/%(year)s%(month)02d/</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
