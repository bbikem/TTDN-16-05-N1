<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bang_cham_cong_form" model="ir.ui.view">
            <field name="name">bang_cham_cong.form</field>
            <field name="model">bang_cham_cong</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_fill_gio_dung_gio" type="object" class="oe_highlight" string="Fill giờ đúng giờ"/>
                            <button name="action_fill_gio_di_muon" type="object" class="oe_highlight" string="Fill giờ đi muộn 15p"/>
                            <button name="action_fill_gio_ve_som" type="object" class="oe_highlight" string="Fill giờ về sớm 15p"/>
                        </div>
                        <div class="oe_read_only" style="font-size:25px">Bảng chấm công</div>
                        <group col="4" string="Thông tin chung">
                            <field name="nhan_vien_id"/>
                            <field name="ngay_cham_cong"/>
                            <field name="ca_lam"/>
                            <field name="gio_vao_ca" readonly="1"/>
                            <field name="gio_ra_ca" readonly="1"/>
                            <field name="gio_vao"/>
                            <field name="gio_ra"/>
                            <field name="phut_di_muon" readonly="1"/>
                            <field name="phut_ve_som" readonly="1"/>
                            <field name="trang_thai" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_bang_cham_cong_tree" model="ir.ui.view">
            <field name="name">bang_cham_cong.tree</field>
            <field name="model">bang_cham_cong</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nhan_vien_id"/>
                    <field name="ngay_cham_cong"/>
                    <field name="ca_lam"/>
                    <field name="gio_vao_ca"/>
                    <field name="gio_ra_ca"/>
                    <field name="gio_vao"/>
                    <field name="gio_ra"/>
                    <field name="phut_di_muon"/>
                    <field name="phut_ve_som"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>

        <record id="bang_cham_cong_search" model="ir.ui.view">
            <field name="model">bang_cham_cong</field>
            <field name="arch" type="xml">
                <search>
                    <field name="nhan_vien_id"/>
                    <field name="ngay_cham_cong"/>
                    <field name="ca_lam"/>
                    <field name="gio_vao_ca"/>
                    <field name="gio_ra_ca"/>
                    <field name="gio_vao"/>
                    <field name="gio_ra"/>
                    <field name="phut_di_muon"/>
                    <field name="phut_ve_som"/>
                    <field name="trang_thai"/>
                </search>
            </field>
        </record>

        <record id="action_bang_cham_cong" model="ir.actions.act_window">
            <field name="name">Bảng chấm công</field>
            <field name="res_model">bang_cham_cong</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="bang_cham_cong_search"/>
        </record>
    </data>
</odoo>
