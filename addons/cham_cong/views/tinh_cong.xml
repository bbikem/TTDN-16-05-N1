<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tính công - Tree View -->
        <record id="view_tinh_cong_tree" model="ir.ui.view">
            <field name="name">Tính công - Tree</field>
            <field name="model">tinh_cong</field>
            <field name="arch" type="xml">
                <tree decoration-muted="state=='locked'" decoration-success="state=='confirmed'" decoration-warning="state=='calculated'">
                    <field name="ma_tinh_cong"/>
                    <field name="ngay_bat_dau"/>
                    <field name="ngay_ket_thuc"/>
                    <field name="phong_ban_id"/>
                    <field name="tong_nhan_vien"/>
                    <field name="tong_cong"/>
                    <field name="tong_ot"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Tính công - Form View -->
        <record id="view_tinh_cong_form" model="ir.ui.view">
            <field name="name">Tính công - Form</field>
            <field name="model">tinh_cong</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_calculate" type="object" string="Tính toán" class="oe_highlight" states="draft"/>
                        <button name="action_confirm" type="object" string="Xác nhận" class="oe_highlight" states="calculated"/>
                        <button name="action_lock" type="object" string="Khóa" class="oe_highlight" states="confirmed"/>
                        <button name="action_unlock" type="object" string="Mở khóa" states="locked"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,calculated,confirmed,locked"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="ma_tinh_cong" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="ngay_bat_dau"/>
                                <field name="ngay_ket_thuc"/>
                                <field name="thang" readonly="1"/>
                                <field name="nam" readonly="1"/>
                            </group>
                            <group>
                                <field name="phong_ban_id" optional="show"/>
                                <field name="tong_nhan_vien" readonly="1"/>
                                <field name="tong_cong" readonly="1"/>
                                <field name="tong_ot" readonly="1"/>
                            </group>
                        </group>

                        <separator string="Chi tiết tính công"/>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="nhan_vien_id"/>
                                <field name="so_cong"/>
                                <field name="ot_gio"/>
                                <field name="so_di_muon"/>
                                <field name="so_ve_som"/>
                                <field name="so_vang"/>
                                <field name="ghi_chu"/>
                            </tree>
                        </field>

                        <separator string="Ghi chú"/>
                        <field name="ghi_chu" nolabel="1"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Tính công - Search -->
        <record id="view_tinh_cong_search" model="ir.ui.view">
            <field name="name">Tính công - Search</field>
            <field name="model">tinh_cong</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ma_tinh_cong"/>
                    <field name="phong_ban_id"/>
                    <field name="state"/>
                    <separator/>
                    <filter name="filter_draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_calculated" string="Đã tính toán" domain="[('state', '=', 'calculated')]"/>
                    <filter name="filter_confirmed" string="Đã xác nhận" domain="[('state', '=', 'confirmed')]"/>
                    <filter name="filter_locked" string="Khóa" domain="[('state', '=', 'locked')]"/>
                    <separator/>
                    <group expand="0" string="Nhóm theo">
                        <filter name="group_phong_ban" string="Phòng ban" context="{'group_by': 'phong_ban_id'}"/>
                        <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Tính công - Action -->
        <record id="action_tinh_cong" model="ir.actions.act_window">
            <field name="name">Tính công</field>
            <field name="res_model">tinh_cong</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo dữ liệu tính công mới
                </p>
            </field>
        </record>
    </data>
</odoo>
