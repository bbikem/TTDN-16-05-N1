<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Thanh toán lương - Tree View -->
        <record id="view_thanh_toan_luong_tree" model="ir.ui.view">
            <field name="name">Thanh toán lương - Tree</field>
            <field name="model">thanh_toan_luong</field>
            <field name="arch" type="xml">
                <tree decoration-success="state=='done'" decoration-warning="state=='processed'" decoration-muted="state=='draft'">
                    <field name="ma_thanh_toan"/>
                    <field name="bang_luong_id"/>
                    <field name="ngay_thanh_toan"/>
                    <field name="kinh_te"/>
                    <field name="tong_net" sum="Tổng NET"/>
                    <field name="tong_thanh_toan" sum="Tổng thanh toán"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Thanh toán lương - Form View -->
        <record id="view_thanh_toan_luong_form" model="ir.ui.view">
            <field name="name">Thanh toán lương - Form</field>
            <field name="model">thanh_toan_luong</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm" type="object" string="Xác nhận" class="oe_highlight" states="draft"/>
                        <button name="action_process" type="object" string="Xử lý" class="oe_highlight" states="confirmed"/>
                        <button name="action_done" type="object" string="Hoàn thành" class="oe_highlight" states="processed"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,processed,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="ma_thanh_toan" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="bang_luong_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="ngay_thanh_toan"/>
                                <field name="kinh_te"/>
                            </group>
                            <group>
                                <field name="tong_net" readonly="1"/>
                                <field name="tong_thanh_toan" readonly="1"/>
                            </group>
                        </group>

                        <separator string="Chi tiết thanh toán"/>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="bang_luong_line_id" invisible="1"/>
                                <field name="nhan_vien_id" readonly="1"/>
                                <field name="net" readonly="1"/>
                                <field name="so_tien_thanh_toan"/>
                                <field name="so_tien_chuyen_lan_sau" readonly="1"/>
                                <field name="so_tai_khoan"/>
                                <field name="ngan_hang"/>
                            </tree>
                        </field>

                        <separator string="Ghi chú"/>
                        <field name="ghi_chu" nolabel="1"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Thanh toán lương - Search -->
        <record id="view_thanh_toan_luong_search" model="ir.ui.view">
            <field name="name">Thanh toán lương - Search</field>
            <field name="model">thanh_toan_luong</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ma_thanh_toan"/>
                    <field name="bang_luong_id"/>
                    <field name="kinh_te"/>
                    <separator/>
                    <filter name="filter_draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_confirmed" string="Đã xác nhận" domain="[('state', '=', 'confirmed')]"/>
                    <filter name="filter_processed" string="Đã xử lý" domain="[('state', '=', 'processed')]"/>
                    <filter name="filter_done" string="Hoàn thành" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter name="filter_bank" string="Chuyển khoản" domain="[('kinh_te', '=', 'bank')]"/>
                    <filter name="filter_cash" string="Tiền mặt" domain="[('kinh_te', '=', 'cash')]"/>
                </search>
            </field>
        </record>

        <!-- Thanh toán lương - Action -->
        <record id="action_thanh_toan_luong" model="ir.actions.act_window">
            <field name="name">Thanh toán lương</field>
            <field name="res_model">thanh_toan_luong</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
