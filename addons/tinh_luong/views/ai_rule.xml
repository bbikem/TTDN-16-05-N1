<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- TREE (debug) -->
    <record id="view_ai_rule_tree" model="ir.ui.view">
      <field name="name">ai_rule.tree</field>
      <field name="model">ai_rule</field>
      <field name="arch" type="xml">
        <tree string="Cấu hình AI Rule" create="0" delete="0">
          <field name="name" string="Tên cấu hình"/>
          <field name="max_cong" string="Ngưỡng công tối đa"/>
          <field name="max_ot_gio" string="Ngưỡng OT tối đa (giờ)"/>
          <field name="max_net" string="Ngưỡng NET tối đa"/>
        </tree>
      </field>
    </record>

    <!-- SEARCH -->
    <record id="view_ai_rule_search" model="ir.ui.view">
      <field name="name">ai_rule.search</field>
      <field name="model">ai_rule</field>
      <field name="arch" type="xml">
        <search string="Tìm AI Rule">
          <field name="name" string="Tên cấu hình"/>
        </search>
      </field>
    </record>

    <!-- FORM -->
    <record id="view_ai_rule_form" model="ir.ui.view">
      <field name="name">ai_rule.form</field>
      <field name="model">ai_rule</field>
      <field name="arch" type="xml">
        <form string="Cấu hình AI Rule" create="0" delete="0">
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" readonly="1"/>
              </h1>
              <p class="text-muted">
                Thiết lập ngưỡng để hệ thống gắn cờ <b>bất thường</b> khi kiểm tra bảng lương.
              </p>
            </div>

            <group string="Ngưỡng kiểm tra" col="4">
              <field name="max_cong" string="Ngưỡng công tối đa"/>
              <field name="max_ot_gio" string="Ngưỡng OT tối đa (giờ)"/>
              <field name="max_net" string="Ngưỡng NET tối đa"/>
            </group>
          </sheet>

          <!-- Chatter -->
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers"/>
            <field name="activity_ids" widget="mail_activity"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>

        </form>
      </field>
    </record>

    <!-- ACTION (act_window) - GIỮ ID action_ai_rule để không đụng DB -->
    <record id="action_ai_rule" model="ir.actions.act_window">
      <field name="name">AI Rule</field>
      <field name="res_model">ai_rule</field>
      <field name="view_mode">form</field>
      <field name="target">current</field>
      <!-- act_window này chỉ để "có action ổn định" -->
    </record>

    <!-- ACTION (debug list) -->
    <record id="action_ai_rule_list" model="ir.actions.act_window">
      <field name="name">AI Rule (Danh sách)</field>
      <field name="res_model">ai_rule</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="view_ai_rule_search"/>
    </record>

    <!-- SERVER ACTION (Pro) - xmlid MỚI để mở singleton -->
    <record id="action_ai_rule_open_singleton" model="ir.actions.server">
      <field name="name">Mở AI Rule (Singleton)</field>
      <field name="model_id" ref="model_ai_rule"/>
      <field name="state">code</field>
      <field name="code">action = env['ai_rule'].action_open_singleton()</field>
    </record>

  </data>
</odoo>
