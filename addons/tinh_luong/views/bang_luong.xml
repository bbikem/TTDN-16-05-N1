<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- TREE -->
    <record id="view_bang_luong_tree" model="ir.ui.view">
      <field name="name">bang_luong.tree</field>
      <field name="model">bang_luong</field>
      <field name="arch" type="xml">
        <tree string="Bảng lương" default_order="nam desc, thang desc, id desc">
          <field name="name" string="Tên bảng lương"/>
          <field name="thang" string="Tháng"/>
          <field name="nam" string="Năm"/>
          <field name="state" string="Trạng thái"/>
          <field name="tong_gross" string="Tổng Gross"/>
          <field name="tong_net" string="Tổng Net"/>
        </tree>
      </field>
    </record>

    <!-- SEARCH -->
    <record id="view_bang_luong_search" model="ir.ui.view">
      <field name="name">bang_luong.search</field>
      <field name="model">bang_luong</field>
      <field name="arch" type="xml">
        <search string="Tìm bảng lương">
          <field name="thang" string="Tháng"/>
          <field name="nam" string="Năm"/>
          <field name="state" string="Trạng thái"/>
          <separator/>

          <filter string="Nháp" name="st_draft" domain="[('state','=','draft')]"/>
          <filter string="Đã xác nhận" name="st_confirmed" domain="[('state','=','confirmed')]"/>
          <filter string="Đã duyệt" name="st_approved" domain="[('state','=','approved')]"/>
          <filter string="Đã chi" name="st_paid" domain="[('state','=','paid')]"/>

          <separator/>
          <!-- Có cảnh báo AI: tồn tại line warning/danger -->
          <filter string="Có cảnh báo AI" name="has_ai"
                  domain="[('line_ids.ai_flag','in',['warning','danger'])]"/>

          <group expand="0" string="Nhóm theo">
            <filter string="Trạng thái" name="grp_state" context="{'group_by':'state'}"/>
            <filter string="Năm" name="grp_year" context="{'group_by':'nam'}"/>
            <filter string="Tháng" name="grp_month" context="{'group_by':'thang'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- FORM -->
    <record id="view_bang_luong_form" model="ir.ui.view">
      <field name="name">bang_luong.form</field>
      <field name="model">bang_luong</field>
      <field name="arch" type="xml">
        <form string="Bảng lương">
          <header>

            <!-- Actions -->
            <button name="action_generate" type="object" string="Sinh bảng lương"
                    class="btn-primary" states="draft"/>

            <button name="action_ai_check" type="object" string="AI Check"
                    class="btn-secondary" states="draft,confirmed,approved"/>

            <!-- Workflow -->
            <button name="action_confirm" type="object" string="Xác nhận" states="draft"/>
            <button name="action_approve" type="object" string="Duyệt" states="confirmed"/>
            <button name="action_paid" type="object" string="Đã chi" states="approved"/>

            <!-- (Chặng 8) Gửi phiếu lương: bật sau -->
            <!-- <button name="action_send_payslips" type="object" string="Gửi phiếu lương"
                    class="btn-primary" states="approved,paid"/> -->

            <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,approved,paid"/>
          </header>

          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" readonly="1"/>
              </h1>
            </div>

            <group string="Thông tin kỳ lương" col="4">
              <field name="thang" string="Tháng"/>
              <field name="nam" string="Năm"/>
              <field name="tong_gross" string="Tổng Gross" readonly="1"/>
              <field name="tong_net" string="Tổng Net" readonly="1"/>
            </group>

            <notebook>

              <!-- TAB: Chi tiết -->
              <page string="Chi tiết bảng lương">
                <field name="line_ids" context="{'default_bang_luong_id': active_id}">
                  <tree editable="bottom" string="Chi tiết"
                        decoration-warning="ai_flag == 'warning'"
                        decoration-danger="ai_flag == 'danger'">
                    <field name="nhan_vien_id" string="Nhân viên"/>
                    <field name="so_cong" string="Số công"/>
                    <field name="ot_gio" string="OT (giờ)"/>

                    <field name="luong_don_gia" string="Lương (đơn giá)" readonly="1"/>
                    <field name="he_so_chuc_vu" string="Hệ số" readonly="1"/>
                    <field name="ot_tien" string="Tiền OT" readonly="1"/>

                    <field name="phu_cap" string="Phụ cấp"/>
                    <field name="khau_tru_khac" string="Khấu trừ khác"/>

                    <field name="bhxh" string="BHXH" readonly="1"/>
                    <field name="bhyt" string="BHYT" readonly="1"/>
                    <field name="bhtn" string="BHTN" readonly="1"/>
                    <field name="tong_bao_hiem" string="Tổng BH" readonly="1"/>

                    <field name="gross" string="Gross" readonly="1"/>
                    <field name="net" string="Net" readonly="1"/>

                    <field name="ai_flag" string="AI" readonly="1"/>
                    <field name="ai_note" string="Ghi chú AI" readonly="1"/>
                  </tree>
                </field>
              </page>

              <!-- TAB: Cảnh báo AI (lọc nhanh) -->
              <page string="Cảnh báo AI">
                <field name="line_ids" domain="[('ai_flag','in',['warning','danger'])]">
                  <tree string="Dòng bất thường"
                        decoration-warning="ai_flag == 'warning'"
                        decoration-danger="ai_flag == 'danger'">
                    <field name="nhan_vien_id" string="Nhân viên"/>
                    <field name="so_cong" string="Số công"/>
                    <field name="ot_gio" string="OT (giờ)"/>
                    <field name="net" string="Net" readonly="1"/>
                    <field name="ai_flag" string="AI" readonly="1"/>
                    <field name="ai_note" string="Ghi chú" readonly="1"/>
                  </tree>
                </field>
              </page>

            </notebook>
          </sheet>

          <!-- Chatter (pro) -->
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers"/>
            <field name="activity_ids" widget="mail_activity"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>

        </form>
      </field>
    </record>

    <!-- ACTION -->
    <record id="action_bang_luong" model="ir.actions.act_window">
      <field name="name">Bảng lương</field>
      <field name="res_model">bang_luong</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="view_bang_luong_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Tạo bảng lương theo tháng/năm và sinh tự động từ dữ liệu chấm công.
        </p>
      </field>
    </record>

  </data>
</odoo>
